{
    "title": "Into the Rabbithole",
    "description": "Find and enter the rabbithole",
    "commands_taught": ["ls", "cd", "chmod"],
    "steps": [
        {
            "step": 1,
            "story": [
                "Woah! You destroyed the note.",
                "",
                "Eleanor: \"It's time to find that rabbit and put an end to this!\"",
                "\"Let's go to where we met the rabbit.\""
            ],
            "start_dir": "~/town/east/library/private-section",
            "end_dir": "~/woods/thicket",
            "commands": ["cd ~/woods/thicket"],
            "hints": [
                "Use 'cd ~/woods/thicket' to go to the thicket."
            ],
            "next": [61, 2]
        },
        {
            "step": 2,
            "story": [
                "You're back at the thicket.",
                "Eleanor: \"Look around.\""
            ],
            "start_dir": "~/woods/thicket",
            "end_dir": "~/woods/thicket",
            "commands": ["ls", "ls -a"],
            "hints": [
                "Use 'ls' to look around."
            ],
            "next": [61, 3]
        },
        {
            "step": 3,
            "story": [
                "You are outside the rabbithole. It has a large boulder in front of it.",
                "Eleanor: \"Try to go inside.\""
            ],
            "start_dir": "~/woods/thicket",
            "end_dir": "~/woods/thicket",
            "commands": ["cd rabbithole", "cd rabbithole/"],
            "hints": [
                "Use 'cd rabbithole' to try to go inside."
            ],
            "next": [61, 4]
        },
        {
            "step": 4,
            "story": [
                "You cannot get past the boulder.",
                "The rabbithole is completely inaccessible.",
                "",
                "Eleanor: \"Unlock it! Use the same command we used for the private-section.\""
            ],
            "start_dir": "~/woods/thicket",
            "end_dir": "~/woods/thicket/rabbithole",
            "commands": ["chmod +rwx rabbithole", "chmod +rwx rabbithole/"],
